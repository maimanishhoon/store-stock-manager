# Port (Render and Railway inject this automatically)
PORT=8080

# Database Configuration (MySQL 8.x)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/diwali_shop_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# JWT Authentication Secret (64+ character random hex or string)
JWT_SECRET=9a67279c2f864b48b7b28a8a49b7528e5791c7b153e7e41f10cadf836d40d7b9e
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (Used when building frontend)
# Set to your backend public URL, e.g. https://diwali-backend.up.railway.app
VITE_API_URL=http://localhost:8080
